# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored by default - it will NEVER be committed.

GEMINI_API_KEY=your_gemini_api_key

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=generate_your_own_random_secret

# From a GitHub OAuth App you register at github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret
